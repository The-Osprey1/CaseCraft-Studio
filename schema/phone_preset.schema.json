{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CaseCraft phone preset",
  "type": "object",
  "required": [
    "id",
    "body",
    "camera"
  ],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9_]+$"
    },
    "name": {
      "type": "string",
      "maxLength": 80
    },
    "brand": {
      "type": "string",
      "maxLength": 80,
      "description": "device maker, groups devices in the picker ('' = Other)"
    },
    "year": {
      "type": "integer",
      "minimum": 0,
      "maximum": 2100,
      "description": "release year, newest first in the picker (0 = unknown)"
    },
    "body": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "length",
        "width",
        "thickness",
        "corner_radius"
      ],
      "properties": {
        "length": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "width": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "thickness": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "corner_radius": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "camera": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "x": {
          "type": "number",
          "description": "from top-left of BACK view"
        },
        "y": {
          "type": "number"
        },
        "width": {
          "type": "number",
          "exclusiveMinimum": 0,
          "description": "island width at its BASE (against the phone back)"
        },
        "height": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "radius": {
          "type": "number",
          "minimum": 0
        },
        "opening": {
          "description": "optional clear aperture at the case's OUTER face; the aperture is lofted from the island base to this profile. dx/dy shift it from the island centre like x/y (back view: +dx right, +dy down).",
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": false,
          "required": [
            "width",
            "height"
          ],
          "properties": {
            "width": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "height": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "radius": {
              "type": "number",
              "minimum": 0
            },
            "dx": {
              "type": "number"
            },
            "dy": {
              "type": "number"
            }
          }
        },
        "ring": {
          "type": "boolean",
          "default": true,
          "description": "true: press-fit camera ring with a raised bezel in a backplate cut-out. false: open cut-out (island + aperture margin + ring clearance) that may run through the backplate edge, for islands that reach the edge and full-width camera plateaus (x = y = 0, width = body width)"
        }
      }
    },
    "buttons": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "side",
          "pos",
          "length"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "side": {
            "enum": [
              "left",
              "right",
              "top",
              "bottom"
            ]
          },
          "pos": {
            "type": "number",
            "minimum": 0
          },
          "length": {
            "type": "number",
            "exclusiveMinimum": 0
          }
        }
      }
    },
    "ports": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "side",
          "width",
          "height"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "side": {
            "enum": [
              "left",
              "right",
              "top",
              "bottom"
            ]
          },
          "center": {
            "type": "number"
          },
          "width": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "height": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "radius": {
            "type": "number",
            "minimum": 0
          },
          "z_offset": {
            "type": "number"
          },
          "chamfer": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0,
            "maximum": 1.5,
            "description": "outer 45deg flare of this opening in mm (null = style.port_chamfer), e.g. a Camera Control finger scoop"
          }
        }
      }
    },
    "clearances": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "frame_to_phone_offset": {
          "type": "number",
          "minimum": 0,
          "maximum": 1.0,
          "default": 0.25
        },
        "backplate_snap_clearance": {
          "type": "number",
          "minimum": 0.05,
          "maximum": 0.4,
          "default": 0.15
        },
        "button_clearance": {
          "type": "number",
          "minimum": 0.05,
          "maximum": 0.5,
          "default": 0.2
        },
        "camera_ring_clearance": {
          "type": "number",
          "minimum": 0.05,
          "maximum": 0.4,
          "default": 0.15
        }
      }
    },
    "style": {
      "type": "object",
      "additionalProperties": false,
      "description": "Case construction and print details (params.Style). Every key is optional; omitted keys take the default shown. Preset.check() also enforces combined-parameter rules (floors, pockets, rim clearances).",
      "properties": {
        "frame_wall": {
          "type": "number",
          "minimum": 1.0,
          "default": 1.6,
          "description": "TPU side wall thickness (mm)"
        },
        "front_lip": {
          "type": "number",
          "exclusiveMinimum": 0,
          "default": 1.2,
          "description": "inward overhang of the screen lip (mm)"
        },
        "front_lip_thickness": {
          "type": "number",
          "exclusiveMinimum": 0,
          "default": 2.4,
          "description": "screen-lip thickness: 45deg ramp (offset + front_lip) plus >= 0.6 mm flat land"
        },
        "backplate_thickness": {
          "type": "number",
          "minimum": 1.6,
          "maximum": 2.0,
          "default": 1.8,
          "description": "backplate thickness (mm)"
        },
        "tongue_height": {
          "type": "number",
          "exclusiveMinimum": 0,
          "default": 0.8,
          "description": "backplate snap tongue height (mm)"
        },
        "groove_depth": {
          "type": "number",
          "exclusiveMinimum": 0,
          "default": 0.9,
          "description": "retention groove depth into the TPU wall beyond the cavity (mm)"
        },
        "snap_engage": {
          "type": "number",
          "exclusiveMinimum": 0,
          "default": 0.6,
          "description": "how far the rear TPU lip is inboard of the groove (mm)"
        },
        "button_height": {
          "type": "number",
          "exclusiveMinimum": 0,
          "default": 3.0
        },
        "button_cap_height": {
          "type": "number",
          "exclusiveMinimum": 0,
          "default": 0.8
        },
        "button_flange_overhang": {
          "type": "number",
          "exclusiveMinimum": 0,
          "default": 0.8
        },
        "button_flange_thickness": {
          "type": "number",
          "exclusiveMinimum": 0,
          "default": 0.6
        },
        "button_travel": {
          "type": "number",
          "minimum": 0,
          "default": 0.3
        },
        "camera_cutout_margin": {
          "type": "number",
          "minimum": 0,
          "default": 1.6,
          "description": "backplate camera cut-out = island + this margin per side (mm)"
        },
        "camera_aperture_margin": {
          "type": "number",
          "minimum": 0,
          "default": 0.2,
          "description": "clear aperture around the camera island (mm)"
        },
        "camera_bezel_height": {
          "type": "number",
          "exclusiveMinimum": 0,
          "default": 1.5
        },
        "camera_bezel_width": {
          "type": "number",
          "exclusiveMinimum": 0,
          "default": 1.2
        },
        "camera_bead": {
          "type": "number",
          "minimum": 0,
          "default": 0.3
        },
        "magsafe_ring": {
          "type": "boolean",
          "default": false,
          "description": "magnet-ring pocket on the inside of the backplate"
        },
        "magsafe_depth": {
          "type": "number",
          "default": 0.75,
          "description": "magnet-ring pocket depth (mm); leaves >= 0.7 mm backplate floor"
        },
        "magsafe_offset_y": {
          "type": "number",
          "default": 0.0,
          "description": "magnet-ring centre shift along Y (mm, - = towards the bottom)"
        },
        "port_chamfer": {
          "type": "number",
          "minimum": 0,
          "maximum": 1.2,
          "default": 0.6,
          "description": "outer 45deg flare around every port opening (mm, 0 = straight-walled); a port's own chamfer overrides it"
        },
        "grip_ribs": {
          "type": "boolean",
          "default": false,
          "description": "horizontal 45deg V-grooves on the straight long side walls of the bumper (kept clear of buttons and ports)"
        },
        "grip_rib_depth": {
          "type": "number",
          "minimum": 0.2,
          "maximum": 0.6,
          "default": 0.35,
          "description": "grip groove depth into the outer wall (mm)"
        },
        "compliant_buttons": {
          "type": "boolean",
          "default": true,
          "description": "unibody only: flex slits through the wall beside each integrated TPU button cover"
        },
        "lanyard_pocket": {
          "type": "boolean",
          "default": false,
          "description": "recess on the inside of the backplate (and unibody floor) for a lanyard tether tab, running to the charging port"
        },
        "lanyard_depth": {
          "type": "number",
          "minimum": 0.4,
          "maximum": 0.9,
          "default": 0.65,
          "description": "lanyard tether-tab pocket depth (mm); leaves >= 0.6 mm backplate floor"
        }
      }
    },
    "pattern": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": {
          "enum": [
            "solid",
            "hex",
            "voronoi",
            "grid",
            "waves",
            "svg",
            "text",
            "dots",
            "triangles",
            "chevron"
          ]
        },
        "mode": {
          "enum": [
            "through",
            "deboss",
            "inlay"
          ]
        },
        "depth": {
          "type": "number"
        },
        "margin": {
          "type": "number"
        },
        "web": {
          "type": "number"
        },
        "stencil_bridges": {
          "type": "boolean"
        },
        "edge": {
          "enum": [
            "clip",
            "whole",
            "fade"
          ],
          "description": "Lattice patterns only: clip = cells cut at the border (default), whole = only complete cells, fade = cells shrink towards the border"
        },
        "corner_radius": {
          "type": "number",
          "minimum": 0,
          "maximum": 5,
          "description": "Rounds the corners of lattice and stripe cut-outs (mm); 0 = sharp"
        },
        "fade_width": {
          "type": "number",
          "minimum": 2,
          "maximum": 60,
          "description": "edge = fade: distance from the border over which cells shrink (mm)"
        },
        "params": {
          "type": "object",
          "description": "hex/dots: pitch | voronoi: pitch, seed, relax | grid/triangles: pitch, angle | waves/chevron: pitch, amplitude, wavelength | svg: svg, size, rotation, offset | text: text, font, size, rotation, bold, offset"
        }
      }
    },
    "verification": {
      "description": "optional provenance. Omit (or keep 'approximate') unless you have evidence: 'physically_fit_tested' means a printed case was fitted to the real device.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "level": {
          "enum": [
            "approximate",
            "dimensionally_verified",
            "physically_fit_tested"
          ],
          "default": "approximate"
        },
        "source": {
          "type": "string",
          "description": "where the dimensions came from"
        },
        "fit_test": {
          "enum": [
            "untested",
            "passed",
            "failed"
          ],
          "default": "untested"
        },
        "notes": {
          "type": "string"
        },
        "unverified_features": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  },
  "description": "Device preset for CaseCraft Studio. Documentation and editor support only: params.py (Preset.check) is the single authoritative source of validation rules, including combined-parameter rules this schema cannot express."
}
