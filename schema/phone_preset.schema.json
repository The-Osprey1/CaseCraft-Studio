{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CaseCraft phone preset",
  "type": "object",
  "required": ["id", "body", "camera"],
  "additionalProperties": false,
  "properties": {
    "$schema": {"type": "string"},
    "id": {"type": "string", "pattern": "^[a-z0-9_]+$"},
    "name": {"type": "string"},
    "body": {
      "type": "object", "additionalProperties": false,
      "required": ["length", "width", "thickness", "corner_radius"],
      "properties": {
        "length": {"type": "number", "exclusiveMinimum": 0},
        "width": {"type": "number", "exclusiveMinimum": 0},
        "thickness": {"type": "number", "exclusiveMinimum": 0},
        "corner_radius": {"type": "number", "minimum": 0}
      }
    },
    "camera": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "x": {"type": "number", "description": "from top-left of BACK view"},
        "y": {"type": "number"},
        "width": {"type": "number", "exclusiveMinimum": 0},
        "height": {"type": "number", "exclusiveMinimum": 0},
        "radius": {"type": "number", "minimum": 0}
      }
    },
    "buttons": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false, "required": ["id", "side", "pos", "length"],
        "properties": {
          "id": {"type": "string"},
          "side": {"enum": ["left", "right", "top", "bottom"]},
          "pos": {"type": "number", "minimum": 0},
          "length": {"type": "number", "exclusiveMinimum": 0}
        }
      }
    },
    "ports": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false, "required": ["id", "side", "width", "height"],
        "properties": {
          "id": {"type": "string"},
          "side": {"enum": ["left", "right", "top", "bottom"]},
          "center": {"type": "number"},
          "width": {"type": "number", "exclusiveMinimum": 0},
          "height": {"type": "number", "exclusiveMinimum": 0},
          "radius": {"type": "number", "minimum": 0},
          "z_offset": {"type": "number"}
        }
      }
    },
    "clearances": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "frame_to_phone_offset": {"type": "number", "minimum": 0, "maximum": 1.0, "default": 0.25},
        "backplate_snap_clearance": {"type": "number", "minimum": 0.05, "maximum": 0.4, "default": 0.15},
        "button_clearance": {"type": "number", "minimum": 0.05, "maximum": 0.5, "default": 0.2},
        "camera_ring_clearance": {"type": "number", "minimum": 0.05, "maximum": 0.4, "default": 0.15}
      }
    },
    "style": {"type": "object", "description": "see params.Style for all keys and defaults"},
    "pattern": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "type": {"enum": ["solid", "hex", "voronoi", "grid", "waves", "svg", "text"]},
        "mode": {"enum": ["through", "deboss", "inlay"]},
        "depth": {"type": "number"}, "margin": {"type": "number"}, "web": {"type": "number"},
        "stencil_bridges": {"type": "boolean"},
        "params": {"type": "object"}
      }
    }
  }
}
